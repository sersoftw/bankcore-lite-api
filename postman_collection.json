{
  "info": {
    "name": "BankCore Lite API",
    "description": "Colección básica para probar la API REST bancaria.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Listar clientes",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/clientes"
      }
    },
    {
      "name": "Crear cliente",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Sergio\",\n  \"apellidos\": \"Bernal Galvez\",\n  \"dni\": \"99999999Z\",\n  \"email\": \"sergio.demo@example.com\",\n  \"telefono\": \"600111222\"\n}"
        },
        "url": "{{baseUrl}}/api/clientes"
      }
    },
    {
      "name": "Listar cuentas",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/cuentas"
      }
    },
    {
      "name": "Consultar saldo cuenta 1",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/cuentas/1/saldo"
      }
    },
    {
      "name": "Ingreso cuenta 1",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cantidad\": 100.00,\n  \"descripcion\": \"Ingreso inicial\"\n}"
        },
        "url": "{{baseUrl}}/api/cuentas/1/ingresos"
      }
    },
    {
      "name": "Transferencia normal",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cuentaOrigenId\": 1,\n  \"cuentaDestinoId\": 2,\n  \"cantidad\": 150.00,\n  \"concepto\": \"Pago de servicio\"\n}"
        },
        "url": "{{baseUrl}}/api/transferencias"
      }
    },
    {
      "name": "Transferencia antifraude",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cuentaOrigenId\": 2,\n  \"cuentaDestinoId\": 1,\n  \"cantidad\": 3500.00,\n  \"concepto\": \"Operación elevada\"\n}"
        },
        "url": "{{baseUrl}}/api/transferencias"
      }
    },
    {
      "name": "Listar alertas fraude",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/alertas-fraude"
      }
    }
  ]
}
